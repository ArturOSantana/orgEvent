{
  "name": "retirojovens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w packages/types && npm run build -w apps/api && npm run build -w apps/web",
    "vercel-build": "npm run build -w packages/types && npm run build -w apps/web",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@vercel/node": "^5.5.16",
    "@vercel/static-build": "^2.3.0",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "concurrently": "^9.1.2",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "eslint-plugin-react-hooks": {
      "eslint": "^10.0.0"
    }
  }
}
