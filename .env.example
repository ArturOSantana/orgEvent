# Variaveis de ambiente — copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env

# ---- Banco PostgreSQL gerenciado (Supabase, Neon ou Vercel Postgres) ----
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DATABASE_URL_DIRECT=postgresql://usuario:senha@host:5432/banco

# Segredo para assinatura dos tokens JWT de acesso (access token)
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Segredo para assinatura dos tokens JWT de atualizacao (refresh token)
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_REFRESH_SECRET=

# Porta local da API (na Vercel, o runtime fornece a porta)
PORT=3001

# Origem permitida para CORS (URL do frontend publicado)
CORS_ORIGIN=https://seu-projeto.vercel.app

# URL base da API; deixe vazio na Vercel para usar /api no mesmo dominio
VITE_API_URL=
